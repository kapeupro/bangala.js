---
const navLinks = [
  { label: "Docs", href: "#docs" },
  { label: "npm", href: "https://www.npmjs.com/package/bangala" },
  { label: "GitHub", href: "https://github.com/kapeupro/bangala.js" },
]

const tools = ["Bun", "TypeScript", "Vite", "Node.js", "Deno", "Cloudflare"]

const stats = [
  { target: 0, value: "0", suffix: "kb", label: "JS par défaut" },
  { target: 100, value: "100", suffix: "%", label: "HTML pur, sans runtime" },
  { target: 1, value: "1", suffix: " ligne", label: "pour activer un îlot interactif" },
]

const features = [
  {
    icon: "🪨",
    title: "Zéro JS par défaut",
    description: "Un composant se rend côté serveur et n'envoie rien au navigateur. Pas de runtime, pas d'hydratation, pas de bundle.",
    tag: "0 kb client",
    tagClass: "feat-tag tag-green",
  },
  {
    icon: "🏝️",
    title: "Islands Architecture",
    description: "Marquez",
    code: "client:load",
    afterCode: "et lui seul devient un îlot chargé indépendamment. Le reste reste du HTML inerte.",
    tag: "partial hydration",
    tagClass: "feat-tag tag-blue",
  },
  {
    icon: "⚡",
    title: "Compilé, pas interprété",
    description: "Chaque fichier",
    code: ".bangala",
    afterCode: "est compilé en module JS pur. SSR = concaténation de chaînes.",
    tag: "compile-time",
    tagClass: "feat-tag tag-orange",
  },
  {
    icon: "📄",
    title: "Syntaxe .bangala",
    description: "HTML enrichi avec frontmatter serveur,",
    code: "{}",
    afterCode: ", {#if} et {#each}. Des pages, pas des arbres.",
    tag: "html-first",
    tagClass: "feat-tag tag-purple",
  },
]

const comparisons = [
  {
    header: "Next.js / Nuxt / Remix",
    value: "~300",
    suffix: "kb",
    valueClass: "compare-val compare-val-muted",
    label: "JS initial minimum",
    marker: "✕",
    markerClass: "cross",
    items: [
      { text: "Runtime JS obligatoire" },
      { text: "Hydratation complète" },
      { text: "Bundle même pour du texte" },
      { text: "TTI retardé par le JS" },
    ],
  },
  {
    header: "bangala.js",
    value: "0",
    suffix: "kb",
    valueClass: "compare-val compare-val-accent",
    label: "JS par défaut",
    marker: "✓",
    markerClass: "check",
    items: [
      { text: "HTML pur, zéro runtime" },
      { text: "Hydratation optionnelle" },
      { text: "JS uniquement sur", code: "client:load" },
      { text: "TTI = temps de réponse serveur" },
    ],
  },
]

const footerLinks = [
  { label: "GitHub", href: "https://github.com/kapeupro/bangala.js" },
  { label: "npm", href: "https://www.npmjs.com/package/bangala" },
  { label: "Docs", href: "#docs" },
  { label: "Issues", href: "https://github.com/kapeupro/bangala.js/issues" },
]
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>bangala.js - HTML-first framework</title>
<link rel="icon" href="./favicon.svg" type="image/svg+xml"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;900&amp;family=Geist+Mono:wght@400;500&amp;display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#060608;
  --bg2:#0c0c10;
  --bg3:#13131a;
  --border:#1e1e2a;
  --border2:#2a2a38;
  --text:#f0f0f8;
  --text2:#8888a8;
  --text3:#4a4a68;
  --accent:#f97316;
  --accent2:#fb923c;
  --green:#22c55e;
  --blue:#60a5fa;
  --purple:#a78bfa;
  --mono:'Geist Mono',monospace;
  --sans:'Geist',sans-serif;
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--sans);line-height:1.6;overflow-x:hidden}
a:focus-visible,button:focus-visible{outline:2px solid var(--accent2);outline-offset:3px}

nav{
  position:sticky;top:0;z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 2.5rem;height:60px;
  background:rgba(6,6,8,0.9);
  border-bottom:1px solid var(--border);
  backdrop-filter:blur(20px);
}
.nav-logo{display:flex;align-items:center;gap:10px;font-size:1rem;font-weight:700;color:var(--text);text-decoration:none;letter-spacing:-0.3px;white-space:nowrap}
.nav-logo svg{flex:0 0 auto}
.gradient-dot{color:var(--accent)}
.nav-links{display:flex;gap:1.5rem;align-items:center}
.nav-links a{color:var(--text2);text-decoration:none;font-size:0.85rem;transition:color .2s}
.nav-links a:hover{color:var(--text)}
.nav-cta{background:var(--accent);color:#fff;font-family:var(--mono);font-size:0.78rem;padding:6px 16px;border-radius:6px;text-decoration:none;font-weight:500;transition:opacity .2s;white-space:nowrap}
.nav-cta:hover{opacity:.85}

.hero{
  min-height:100vh;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:4rem 2rem 6rem;
  position:relative;overflow:hidden;text-align:center;
}
.hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 80% 50% at 50% -10%,rgba(249,115,22,0.09) 0%,transparent 70%);pointer-events:none}
.hero-grid{
  position:absolute;inset:0;
  background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);
  background-size:60px 60px;opacity:.3;
  mask-image:radial-gradient(ellipse 70% 60% at 50% 0%,black 0%,transparent 80%);
}
.badge{
  display:inline-flex;align-items:center;gap:6px;
  font-size:.72rem;font-family:var(--mono);color:var(--accent);
  border:1px solid rgba(249,115,22,.3);background:rgba(249,115,22,.06);
  padding:4px 12px;border-radius:999px;margin-bottom:1.5rem;
}
.badge-dot{width:5px;height:5px;border-radius:50%;background:var(--accent);animation:pulse 2s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}

h1{font-size:clamp(2.8rem,6vw,5rem);font-weight:900;letter-spacing:-2px;line-height:1.05;max-width:820px;margin-bottom:1.5rem}
.word{display:inline-block}
.gradient-text{background:linear-gradient(135deg,#f97316 0%,#fb923c 40%,#fbbf24 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-sub{font-size:1.1rem;color:var(--text2);max-width:520px;margin:0 auto 2.5rem;line-height:1.7}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-bottom:4rem}
.btn-primary{
  display:inline-flex;align-items:center;gap:8px;
  background:var(--accent);color:#fff;font-family:var(--mono);font-size:.88rem;font-weight:500;
  padding:12px 24px;border-radius:8px;text-decoration:none;
  transition:transform .15s,box-shadow .15s;
  box-shadow:0 0 24px rgba(249,115,22,.25);
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 6px 36px rgba(249,115,22,.4)}
.btn-secondary{
  display:inline-flex;align-items:center;gap:8px;
  background:transparent;color:var(--text2);font-family:var(--mono);font-size:.88rem;
  padding:12px 24px;border-radius:8px;text-decoration:none;
  border:1px solid var(--border2);transition:border-color .2s,color .2s,transform .15s;
}
.btn-secondary:hover{color:var(--text);transform:translateY(-2px)}

.hero-code{
  background:var(--bg2);border:1px solid var(--border2);border-radius:12px;
  padding:0;max-width:620px;width:100%;text-align:left;overflow:hidden;
  box-shadow:0 0 60px rgba(0,0,0,.6);
}
.code-header{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--bg3);gap:16px}
.dots{display:flex;gap:6px}
.dot{width:10px;height:10px;border-radius:50%}
.dot-r{background:#ff5f57}.dot-y{background:#febc2e}.dot-g{background:#28c840}
.code-fname{font-family:var(--mono);font-size:.72rem;color:var(--text3)}
.code-meta{font-family:var(--mono);font-size:.65rem;color:var(--text3)}
.code-body{padding:1.25rem 1.5rem;font-family:var(--mono);font-size:.82rem;line-height:1.9;overflow-x:auto}
.ln{color:var(--text3);user-select:none;margin-right:1.5rem;display:inline-block;width:1.5rem;text-align:right}
.kw{color:#c084fc}.fn{color:#60a5fa}.str{color:#86efac}.cmt{color:#3f3f58}.ctag{color:#f9a8d4}.attr{color:#fca5a5}.br{color:#fbbf24}.punct{color:var(--text2)}
.cursor{display:inline-block;width:2px;height:1em;background:var(--accent);vertical-align:text-bottom;animation:blink .8s step-end infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}

.trusted{padding:2.5rem 2rem;border-top:1px solid var(--border);text-align:center;overflow:hidden}
.trusted-label{font-size:.72rem;font-family:var(--mono);color:var(--text3);letter-spacing:2px;text-transform:uppercase;margin-bottom:1.5rem}
.logos-track{display:flex;gap:3rem;align-items:center;justify-content:center;flex-wrap:wrap;opacity:.3;filter:grayscale(1)}
.logo-txt{font-size:.9rem;font-weight:600;letter-spacing:-.3px;color:var(--text)}

.section{padding:6rem 2rem;max-width:1100px;margin:0 auto}
.section-label{font-size:.72rem;font-family:var(--mono);color:var(--accent);letter-spacing:2px;text-transform:uppercase;margin-bottom:.75rem}
.section-title{font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:800;letter-spacing:-1px;margin-bottom:1rem;line-height:1.15}
.section-sub{color:var(--text2);font-size:1rem;max-width:520px;line-height:1.7;margin-bottom:3rem}

.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border-radius:12px;overflow:hidden;margin-bottom:5rem}
.stat{background:var(--bg);padding:2.5rem 2rem;text-align:center}
.stat-val{font-size:3rem;font-weight:900;letter-spacing:-2px;color:var(--accent);line-height:1}
.stat-val span{font-size:1.5rem}
.stat-label{font-size:.82rem;color:var(--text2);margin-top:.5rem}

.features-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1px;background:var(--border);border-radius:12px;overflow:hidden}
.feat{background:var(--bg);padding:2rem;transition:background .2s;overflow:hidden;position:relative}
.feat::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 0% 0%,rgba(249,115,22,.06) 0%,transparent 60%);opacity:0;transition:opacity .3s}
.feat:hover{background:var(--bg2)}
.feat:hover::before{opacity:1}
.feat-icon{font-size:1.4rem;margin-bottom:1rem;display:block}
.feat-title{font-size:1rem;font-weight:600;margin-bottom:.5rem;letter-spacing:-.3px}
.feat-desc{font-size:.85rem;color:var(--text2);line-height:1.6}
.inline-code{font-family:var(--mono);font-size:.78rem;color:var(--accent)}
.feat-tag{display:inline-block;font-size:.65rem;font-family:var(--mono);padding:2px 8px;border-radius:4px;margin-top:.75rem}
.tag-green{background:rgba(34,197,94,.1);color:#22c55e}
.tag-blue{background:rgba(96,165,250,.1);color:#60a5fa}
.tag-orange{background:rgba(249,115,22,.1);color:var(--accent)}
.tag-purple{background:rgba(167,139,250,.1);color:#a78bfa}

.compare-section{padding:6rem 2rem;background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.compare-inner{max-width:900px;margin:0 auto;text-align:center}
.compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-top:3rem;border-radius:12px;overflow:hidden;border:1px solid var(--border)}
.compare-col{padding:2.5rem}
.compare-col:first-child{background:var(--bg);border-right:1px solid var(--border)}
.compare-col:last-child{background:linear-gradient(135deg,rgba(249,115,22,.05) 0%,rgba(249,115,22,.02) 100%)}
.compare-header{font-size:.75rem;font-family:var(--mono);color:var(--text3);margin-bottom:1rem;text-transform:uppercase;letter-spacing:1px}
.compare-val{font-size:2.8rem;font-weight:800;letter-spacing:-1px;margin-bottom:.25rem}
.compare-val span{font-size:1.5rem}
.compare-val-muted{color:var(--text2)}
.compare-val-accent{color:var(--accent)}
.compare-label{font-size:.85rem;color:var(--text2)}
.compare-list{list-style:none;margin-top:1.5rem;text-align:left}
.compare-list li{font-size:.85rem;color:var(--text2);padding:7px 0;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px}
.compare-list li:last-child{border:none}
.cross{color:#ef4444;font-size:.8rem}.check{color:#22c55e;font-size:.8rem}

.cta-section{padding:7rem 2rem;text-align:center;position:relative;overflow:hidden}
.cta-glow{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:600px;height:300px;background:radial-gradient(ellipse,rgba(249,115,22,.08) 0%,transparent 70%);pointer-events:none}
.cta-section h2{font-size:clamp(2rem,4vw,3.5rem);font-weight:800;letter-spacing:-1.5px;margin-bottom:1rem}
.cta-section p{color:var(--text2);font-size:1rem;margin-bottom:2.5rem}
.cta-section .section-label{color:var(--accent);margin-bottom:.75rem}
.cta-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.install-command{margin-top:1.5rem;font-family:var(--mono);font-size:.8rem;color:var(--text3)}

footer{padding:2rem 2.5rem;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem}
.footer-left{font-size:.82rem;color:var(--text3);font-family:var(--mono)}
.footer-links{display:flex;gap:1.5rem;flex-wrap:wrap}
.footer-links a{font-size:.82rem;color:var(--text3);text-decoration:none;transition:color .2s}
.footer-links a:hover{color:var(--text2)}

.reveal{transform:translateY(0)}

@media (max-width: 760px){
  nav{height:auto;min-height:60px;padding:.75rem 1rem;align-items:flex-start;gap:.75rem}
  .nav-links{gap:.85rem;justify-content:flex-end;flex-wrap:wrap}
  .nav-links a:not(.nav-cta){display:none}
  .hero{min-height:auto;padding:4rem 1rem 5rem}
  h1{font-size:clamp(2.35rem,14vw,3.5rem);letter-spacing:-1.4px}
  .hero-sub{font-size:1rem}
  .hero-actions{margin-bottom:2.5rem}
  .btn-primary,.btn-secondary{width:100%;justify-content:center}
  .code-header{padding:10px 12px}
  .code-meta{display:none}
  .code-body{font-size:.74rem;padding:1rem .85rem}
  .ln{margin-right:.8rem}
  .stats-grid,.compare-grid{grid-template-columns:1fr}
  .compare-col:first-child{border-right:0;border-bottom:1px solid var(--border)}
  .section,.compare-section,.cta-section{padding-left:1rem;padding-right:1rem}
  .stat{padding:2rem 1rem}
  footer{padding:2rem 1rem}
}

@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}
}
</style>
</head>
<body>
<nav id="nav">
  <a href="#" class="nav-logo" aria-label="bangala.js accueil">
    <svg width="28" height="38" viewBox="0 0 80 110" fill="none" aria-hidden="true">
      <ellipse cx="26" cy="104" rx="16" ry="8" fill="none" stroke="#f97316" stroke-width="2" stroke-opacity=".55"/>
      <ellipse cx="54" cy="104" rx="16" ry="8" fill="none" stroke="#f97316" stroke-width="2" stroke-opacity=".55"/>
      <rect x="18" y="52" width="44" height="52" rx="3" fill="none" stroke="#f97316" stroke-width="2"/>
      <rect x="31" y="76" width="18" height="28" rx="3" fill="#f97316" fill-opacity=".15" stroke="#f97316" stroke-width="1.5"/>
      <path d="M12 54 C12 54 12 8 40 2 C68 8 68 54 68 54 Z" fill="none" stroke="#f97316" stroke-width="2"/>
      <path d="M16 54 Q40 50 64 54" stroke="#f97316" stroke-width="1.8" fill="none"/>
      <rect x="50" y="2" width="9" height="15" rx="2" fill="none" stroke="#f97316" stroke-width="1.8"/>
      <rect x="48" y="0" width="13" height="5" rx="2" fill="#f97316" fill-opacity=".45" stroke="#f97316" stroke-width="1.5"/>
    </svg>
    bangala<span class="gradient-dot">.</span>js
  </a>
  <div class="nav-links" aria-label="Navigation principale">
    {#each navLinks as link}
      <a href={link.href}>{link.label}</a>
    {/each}
    <a href="#start" class="nav-cta">npm install bangala</a>
  </div>
</nav>

<main>
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-grid"></div>

    <div class="badge" id="hero-badge">
      <span class="badge-dot"></span>
      HTML-first · Islands Architecture · Zero runtime
    </div>

    <h1 id="hero-title">
      <span class="word">Le</span> <span class="word">framework</span> <span class="word">qui</span> <span class="word">envoie</span><br/>
      <span class="word gradient-text">la&nbsp;page</span><span class="word">,</span> <span class="word">pas</span> <span class="word gradient-text">le&nbsp;framework.</span>
    </h1>

    <p class="hero-sub" id="hero-sub">Vos pages sont du HTML. Le JavaScript n'arrive que là où vous le réclamez explicitement. Zéro bundle, zéro hydratation par défaut.</p>

    <div class="hero-actions" id="hero-actions">
      <a href="#start" class="btn-primary">
        <svg width="14" height="14" fill="none" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1L7 10M7 10L4 7M7 10L10 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M2 12h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        npm install bangala
      </a>
      <a href="https://github.com/kapeupro/bangala.js" class="btn-secondary">
        <svg width="14" height="14" fill="none" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1C3.68 1 1 3.68 1 7c0 2.65 1.72 4.9 4.1 5.69.3.06.41-.13.41-.29V11.3c-1.67.36-2.02-.8-2.02-.8-.27-.7-.67-.88-.67-.88-.55-.37.04-.36.04-.36.61.04.93.62.93.62.54.93 1.41.66 1.76.5.05-.39.21-.66.38-.81-1.33-.15-2.73-.67-2.73-2.97 0-.65.23-1.19.62-1.6-.06-.15-.27-.76.06-1.58 0 0 .5-.16 1.65.62A5.7 5.7 0 0 1 7 4.87c.51 0 1.02.07 1.5.2 1.14-.78 1.64-.62 1.64-.62.33.82.12 1.43.06 1.58.39.41.62.95.62 1.6 0 2.31-1.4 2.82-2.74 2.97.22.18.41.55.41 1.11v1.65c0 .16.11.35.41.29C11.28 11.9 13 9.65 13 7c0-3.32-2.68-6-6-6Z" fill="currentColor"/></svg>
        GitHub
      </a>
    </div>

    <div class="hero-code" id="hero-code">
      <div class="code-header">
        <div class="dots" aria-hidden="true"><div class="dot dot-r"></div><div class="dot dot-y"></div><div class="dot dot-g"></div></div>
        <span class="code-fname">blog.bangala</span>
        <span class="code-meta">server → html</span>
      </div>
      <div class="code-body" id="code-body">
<span class="ln">1</span><span class="cmt">--- serveur ---</span>
<span class="ln">2</span><span class="kw">const</span> <span class="fn">posts</span> = <span class="kw">await</span> <span class="fn">db</span><span class="punct">.</span>posts<span class="punct">.</span><span class="fn">recent</span><span class="punct">()</span>
<span class="ln">3</span><span class="cmt">---</span>
<span class="ln">4</span>
<span class="ln">5</span><span class="ctag">&lt;h1&gt;</span>Le blog<span class="ctag">&lt;/h1&gt;</span>
<span class="ln">6</span><span class="br">&#123;#each</span> posts <span class="kw">as</span> post<span class="br">&#125;</span>
<span class="ln">7</span>  <span class="ctag">&lt;article&gt;</span><span class="punct">&#123;</span>post<span class="punct">.</span>title<span class="punct">&#125;</span><span class="ctag">&lt;/article&gt;</span>
<span class="ln">8</span><span class="br">&#123;/each&#125;</span>
<span class="ln">9</span>
<span class="ln">10</span><span class="ctag">&lt;Newsletter</span> <span class="attr">client:load</span> <span class="ctag">/&gt;</span>  <span class="cmt">&lt;!-- seul JS --&gt;</span><span class="cursor"></span>
      </div>
    </div>
  </section>

  <div class="trusted">
    <div class="trusted-label reveal">Compatible avec vos outils</div>
    <div class="logos-track reveal">
      {#each tools as tool}
        <span class="logo-txt">{tool}</span>
      {/each}
    </div>
  </div>

  <section class="section" id="docs">
    <div class="stats-grid">
      {#each stats as stat}
        <div class="stat">
          <div class="stat-val" data-target={stat.target}>{stat.value}<span>{stat.suffix}</span></div>
          <div class="stat-label">{stat.label}</div>
        </div>
      {/each}
    </div>

    <p class="section-label reveal">Fonctionnalités</p>
    <h2 class="section-title reveal">Tout ce qu'il faut.<br/>Rien de superflu.</h2>
    <p class="section-sub reveal">Chaque décision de bangala.js part d'un principe simple : ce que vous n'utilisez pas ne doit pas exister dans le navigateur.</p>

    <div class="features-grid">
      {#each features as feature}
        <div class="feat reveal">
          <span class="feat-icon">{feature.icon}</span>
          <div class="feat-title">{feature.title}</div>
          <div class="feat-desc">
            {feature.description}
            {#if feature.code}
              <code class="inline-code">{feature.code}</code>
              {feature.afterCode}
            {/if}
          </div>
          <span class={feature.tagClass}>{feature.tag}</span>
        </div>
      {/each}
    </div>
  </section>

  <section class="compare-section">
    <div class="compare-inner">
      <p class="section-label reveal">Comparaison</p>
      <h2 class="section-title reveal compare-title">Next.js envoie le framework.<br/><span class="gradient-text">bangala.js</span> envoie la page.</h2>
      <div class="compare-grid reveal">
        {#each comparisons as column}
          <div class="compare-col">
            <div class="compare-header">{column.header}</div>
            <div class={column.valueClass}>{column.value}<span>{column.suffix}</span></div>
            <div class="compare-label">{column.label}</div>
            <ul class="compare-list">
              {#each column.items as item}
                <li>
                  <span class={column.markerClass}>{column.marker}</span>
                  {item.text}
                  {#if item.code}
                    <code class="inline-code">{item.code}</code>
                  {/if}
                </li>
              {/each}
            </ul>
          </div>
        {/each}
      </div>
    </div>
  </section>

  <section class="cta-section" id="start">
    <div class="cta-glow"></div>
    <p class="section-label reveal">Démarrer</p>
    <h2 class="reveal">Prêt à construire<br/><span class="gradient-text">léger&nbsp;?</span></h2>
    <p class="reveal">Une commande. Le compilateur, le runtime d'îlots, le routeur, les helpers Vite et la CLI <code class="inline-code">v0.4.0</code>.</p>
    <div class="cta-actions reveal">
      <a href="https://www.npmjs.com/package/bangala" class="btn-primary">Installer v0.4.0</a>
      <a href="#docs" class="btn-secondary">Lire la doc</a>
    </div>
    <div class="install-command reveal">npm install bangala</div>
  </section>
</main>

<footer>
  <div class="footer-left">bangala.js - MIT License - v0.4.0</div>
  <div class="footer-links">
    {#each footerLinks as link}
      <a href={link.href}>{link.label}</a>
    {/each}
  </div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script>
if (window.gsap && window.ScrollTrigger) {
  gsap.registerPlugin(ScrollTrigger);

  gsap.set(['#hero-badge', '#hero-sub', '#hero-actions', '#hero-code'], { opacity: 0, y: 24 });
  gsap.set('#hero-title', { opacity: 0 });
  gsap.set('.reveal', { opacity: 0, y: 32 });

  gsap.from('#nav', {
    y: -60, opacity: 0, duration: 0.6, ease: 'power3.out', delay: 0.1
  });

  const heroTl = gsap.timeline({ delay: 0.4 });

  heroTl
    .to('#hero-badge', { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' })
    .to('#hero-title', { opacity: 1, duration: 0.01 }, '-=0.1')
    .from('#hero-title .word', {
      opacity: 0,
      y: 40,
      rotateX: -20,
      stagger: 0.07,
      duration: 0.6,
      ease: 'power3.out',
    }, '-=0.1')
    .to('#hero-sub', { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.2')
    .to('#hero-actions', { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.2')
    .to('#hero-code', {
      opacity: 1, y: 0, duration: 0.7, ease: 'power3.out',
      onComplete: typewriterEffect
    }, '-=0.1');

  function typewriterEffect() {
    const lines = document.querySelectorAll('#code-body > span[class="ln"]');
    gsap.from(lines, {
      opacity: 0,
      x: -8,
      stagger: 0.08,
      duration: 0.3,
      ease: 'power1.out'
    });
  }

  gsap.to('.hero-grid', {
    yPercent: 30,
    ease: 'none',
    scrollTrigger: {
      trigger: '.hero',
      start: 'top top',
      end: 'bottom top',
      scrub: true
    }
  });

  gsap.utils.toArray('.reveal').forEach((el) => {
    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: 0.7,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: el,
        start: 'top 88%',
        toggleActions: 'play none none none'
      }
    });
  });

  const statVals = document.querySelectorAll('.stat-val');
  statVals.forEach((el) => {
    const target = parseInt(el.dataset.target, 10);
    const suffix = el.querySelector('span')?.textContent ?? '';

    if (target !== 0) {
      el.innerHTML = '0<span>' + suffix + '</span>';
    }

    ScrollTrigger.create({
      trigger: el,
      start: 'top 85%',
      once: true,
      onEnter: () => {
        if (target === 0) {
          el.innerHTML = '0<span>kb</span>';
          gsap.from(el, { scale: 0.7, opacity: 0, duration: 0.5, ease: 'back.out(2)' });
          return;
        }
        const obj = { val: 0 };
        gsap.to(obj, {
          val: target,
          duration: 1.4,
          ease: 'power2.out',
          onUpdate: () => {
            const v = Math.round(obj.val);
            el.innerHTML = v + '<span>' + suffix + '</span>';
          },
          onStart: () => gsap.from(el, { scale: 0.7, opacity: 0, duration: 0.5, ease: 'back.out(2)' })
        });
      }
    });
  });

  document.querySelectorAll('.feat').forEach(card => {
    card.addEventListener('mouseenter', () => {
      gsap.to(card, { y: -4, duration: 0.25, ease: 'power2.out' });
    });
    card.addEventListener('mouseleave', () => {
      gsap.to(card, { y: 0, duration: 0.3, ease: 'power2.inOut' });
    });
  });

  document.querySelectorAll('.btn-primary').forEach(btn => {
    btn.addEventListener('mouseenter', () => gsap.to(btn, { scale: 1.04, duration: 0.2, ease: 'power2.out' }));
    btn.addEventListener('mouseleave', () => gsap.to(btn, { scale: 1, duration: 0.2, ease: 'power2.inOut' }));
  });

  gsap.from('.compare-col:first-child', {
    x: -40, opacity: 0, duration: 0.7, ease: 'power3.out',
    scrollTrigger: { trigger: '.compare-grid', start: 'top 80%' }
  });
  gsap.from('.compare-col:last-child', {
    x: 40, opacity: 0, duration: 0.7, ease: 'power3.out',
    scrollTrigger: { trigger: '.compare-grid', start: 'top 80%' }
  });

  const logoPaths = document.querySelectorAll('nav svg path, nav svg ellipse, nav svg rect');
  gsap.from(logoPaths, {
    opacity: 0, scale: 0.8, transformOrigin: 'center',
    stagger: 0.04, duration: 0.4, ease: 'power2.out', delay: 0.3
  });
}
</script>
</body>
</html>
