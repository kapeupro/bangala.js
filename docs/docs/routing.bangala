---
import DocsLayout from "../_components/DocsLayout.bangala"
import CodeBlock from "../_components/CodeBlock.bangala"

const dynamic = `---
const { slug } = props.params
---
<article>
  <h1>{slug}</h1>
</article>`;

const manifest = [
  'import { discoverRoutes, matchRoute } from "bangala/router";',
  "",
  'const routes = await discoverRoutes("./pages");',
  'const match = matchRoute(routes, "/blog/hello");',
  "",
  '// match.params.slug === "hello"',
].join("\n");

const headings = [
  { id: "conventions", label: "Conventions" },
  { id: "dynamic-segments", label: "Dynamic segments" },
  { id: "specificity", label: "Specificity" },
  { id: "router-api", label: "Router API" },
];
---
<DocsLayout
  title="File-based Routing | bangala.js"
  description="Routing fichier dans bangala.js : index routes, dynamic segments, catch-all segments et API router."
  path="/docs/routing"
  section="Core Concepts"
  lead="Every .bangala file under pages becomes a route. The URL is the file path, with bracket segments for dynamic values."
  headings={headings}
  prev={{ href: "/docs/islands", label: "Islands Architecture" }}
  next={{ href: "/docs/layouts", label: "Layouts" }}
>
  <h2 id="conventions">Conventions</h2>
  <table class="docs-table">
    <thead><tr><th>File</th><th>Route</th></tr></thead>
    <tbody>
      <tr><td><code>pages/index.bangala</code></td><td><code>/</code></td></tr>
      <tr><td><code>pages/about.bangala</code></td><td><code>/about</code></td></tr>
      <tr><td><code>pages/blog/index.bangala</code></td><td><code>/blog</code></td></tr>
      <tr><td><code>pages/blog/[slug].bangala</code></td><td><code>/blog/:slug</code></td></tr>
      <tr><td><code>pages/docs/[...parts].bangala</code></td><td><code>/docs/*parts</code></td></tr>
    </tbody>
  </table>
  <p>Files and folders starting with <code>_</code> or <code>.</code> are private. The exception is <code>_layout.bangala</code>, documented in <a href="/docs/layouts">Layouts</a>.</p>

  <h2 id="dynamic-segments">Dynamic segments</h2>
  <p>Wrap a segment in square brackets to read it from <code>props.params</code>. Catch-all segments use <code>[...name]</code> and produce an array of path parts.</p>
  <CodeBlock filename="pages/blog/[slug].bangala" code={dynamic}/>

  <h2 id="specificity">Specificity</h2>
  <p>When multiple routes could match, Bangala chooses the most specific route: static segments beat dynamic segments, dynamic segments beat catch-all segments, longer paths beat shorter paths.</p>

  <h2 id="router-api">Router API</h2>
  <p>The router is public and framework-agnostic. Use it from custom servers, build tooling, or tests.</p>
  <CodeBlock filename="scripts/routes.ts" lang="ts" code={manifest}/>
</DocsLayout>
