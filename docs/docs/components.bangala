---
import DocsLayout from "../_components/DocsLayout.bangala"
import CodeBlock from "../_components/CodeBlock.bangala"
import Callout from "../_components/Callout.bangala"
import DocGrid from "../_components/DocGrid.bangala"
import DocCard from "../_components/DocCard.bangala"
import StepList from "../_components/StepList.bangala"

const cardComponent = [
  "---",
  'const { href = "#", title = "", desc = "" } = props',
  "---",
  '<a class="card" href={href}>',
  "  <strong>{title}</strong>",
  "  <span>{desc}</span>",
  "</a>",
].join("\n");

const calloutComponent = [
  "---",
  'const { title = "", variant = "note" } = props',
  'const className = "callout callout-" + variant',
  "---",
  "<div class={className}>",
  "  {#if title}<strong>{title}</strong>{/if}",
  "  <slot/>",
  "</div>",
].join("\n");

const usage = [
  "---",
  'import Callout from "../components/Callout.bangala"',
  'import DocCard from "../components/DocCard.bangala"',
  "---",
  '<Callout title="Server first">',
  "  <p>This renders to HTML. No browser JavaScript is shipped.</p>",
  "</Callout>",
  "",
  '<DocCard href="/docs/islands" title="Islands" desc="Hydrate only what moves."/>',
].join("\n");

const islandBoundary = [
  "---",
  'import Counter from "../components/Counter.bangala"',
  'import FeatureCard from "../components/FeatureCard.bangala"',
  "---",
  '<FeatureCard title="Static copy">',
  "  <p>This remains plain HTML.</p>",
  "</FeatureCard>",
  "",
  "<Counter start={0} client:idle />",
].join("\n");

const steps = [
  { step: "01", title: "Extract repeated markup", desc: "If a card, callout, table, or section appears twice, give it a .bangala component." },
  { step: "02", title: "Keep props boring", desc: "Prefer strings, booleans, arrays, and small objects. The template should stay readable." },
  { step: "03", title: "Use slots for HTML", desc: "Pass rich content as children and place it with <slot/> instead of string-building markup." },
  { step: "04", title: "Add an island only at the edge", desc: "Server components compose the page. Client directives wake up the few components that need browser state." },
];

const headings = [
  { id: "model", label: "Model" },
  { id: "component-props", label: "Props" },
  { id: "slots", label: "Slots" },
  { id: "composition", label: "Composition" },
  { id: "patterns", label: "Patterns" },
];
---
<DocsLayout
  title="Components | bangala.js"
  description="Guide des composants Bangala : props, slots, composition serveur et frontieres client avec les islands."
  path="/docs/components"
  section="Core Concepts"
  lead="Components are how Bangala moves fast without becoming a JavaScript app. Extract repeated HTML, pass explicit props, and keep browser code at the island boundary."
  headings={headings}
  prev={{ href: "/docs/syntax", label: ".bangala syntax" }}
  next={{ href: "/docs/islands", label: "Islands Architecture" }}
>
  <h2 id="model">Model</h2>
  <p>A Bangala component is a normal <code>.bangala</code> file with a default render export generated by the compiler. Capitalized tags import and render components on the server.</p>
  <Callout title="Default rule">
    <p>Components are server-rendered by default. They output HTML and do not ship a client runtime unless you add a <code>client:*</code> directive.</p>
  </Callout>

  <h2 id="component-props">Props</h2>
  <p>Static attributes become string props. Dynamic attributes use JavaScript expressions. This keeps component APIs explicit and easy to scan.</p>
  <CodeBlock filename="components/DocCard.bangala" code={cardComponent}/>

  <h2 id="slots">Slots</h2>
  <p>Use <code>&lt;slot/&gt;</code> when the caller needs to pass HTML children. Slots are the safest way to compose rich markup without creating raw HTML strings.</p>
  <CodeBlock filename="components/Callout.bangala" code={calloutComponent}/>
  <CodeBlock filename="pages/index.bangala" code={usage}/>

  <h2 id="composition">Composition</h2>
  <p>Most UI should be static server composition. Put interactivity at the smallest possible edge with <code>client:load</code>, <code>client:idle</code>, or <code>client:visible</code>.</p>
  <CodeBlock filename="pages/index.bangala" code={islandBoundary}/>

  <DocGrid>
    <DocCard href="/docs/layouts" title="Layouts compose routes" desc="_layout.bangala wraps route trees and shares chrome across pages."/>
    <DocCard href="/docs/islands" title="Islands compose behavior" desc="A client directive hydrates one component without waking the whole page."/>
    <DocCard href="/docs/examples" title="Examples show recipes" desc="Copy the page, blog, layout, island, and deploy patterns into projects."/>
    <DocCard href="/docs/api" title="API stays small" desc="The public surface mirrors the framework pieces: compiler, router, Vite, client, adapters."/>
  </DocGrid>

  <h2 id="patterns">Patterns</h2>
  <StepList items={steps}/>
</DocsLayout>
