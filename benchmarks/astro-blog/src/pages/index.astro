---
import Newsletter from "../components/Newsletter.astro";
import posts from "../../../posts.json";

interface Post {
  id: number;
  title: string;
  date: string;
  excerpt: string;
}

const list = posts as Post[];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Bench blog (Astro)</title>
</head>
<body>
<main>
  <h1>The blog</h1>
  <ul class="posts">
    {list.map((post) => (
      <li class="card">
        <h2>{post.title}</h2>
        <time datetime={post.date}>{post.date}</time>
        <p>{post.excerpt}</p>
      </li>
    ))}
  </ul>

  <Newsletter />
</main>
</body>
</html>
